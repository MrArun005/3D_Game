{
  "name": "nightfall-drive",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.1.0",
  "type": "module",
  "description": "A realistic night-drive through a procedural city, built on three.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "node --test test/*.test.js",
    "ingest": "node tools/ingest.mjs",
    "ingest:check": "node tools/ingest.mjs --check",
    "genkit": "node tools/genkit.mjs",
    "genkit:list": "node tools/genkit.mjs --list",
    "gentex": "node tools/materials.mjs",
    "genchar": "node tools/characters.mjs",
    "genchar:cage": "node tools/characters.mjs --cage",
    "genchar:blender": "python3 tools/blender/build.py"
  },
  "dependencies": {
    "three": "^0.185.1",
    "trystero": "^0.25.4"
  },
  "devDependencies": {
    "vite": "^7.1.5",
    "@gltf-transform/core": "^4.2.1",
    "@gltf-transform/extensions": "^4.2.1",
    "@gltf-transform/functions": "^4.2.1",
    "meshoptimizer": "^0.25.0"
  }
}
