# Immutable asset caching for 3D models and textures
/models/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/textures/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/audio/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/*.glb
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/*.ktx2
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
