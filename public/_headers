# Cache rules (Cloudflare static assets). 2026-09-24: the page itself must
# never be cached, or a phone keeps running an old build after a deploy.
# /assets/* are Vite's content-hashed bundles: safe to keep forever.
# /models, /textures, /audio are NOT hashed (manifest.json changes per
# ingest), so they revalidate hourly instead of the old one-year immutable.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/models/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

/textures/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

/audio/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *
